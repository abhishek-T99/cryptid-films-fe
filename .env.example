# Cryptid Films — frontend environment
#
# Copy this file to `.env` and adjust:
#   cp .env.example .env
#
# Only variables prefixed with VITE_ are exposed to the browser. Everything
# here ends up in the built bundle in plain text, so never put a secret,
# private API key or credential in this file or in `.env`.

# --- API ------------------------------------------------------------------

# Where the Django API lives.
#
# Leave EMPTY in development: requests stay relative (/api/...) and Vite's dev
# proxy forwards them to VITE_DEV_PROXY_TARGET, so the browser sees a single
# origin and CORS never comes up.
#
# Set to an absolute URL for deployed builds, e.g.
#   VITE_API_BASE_URL=https://api.cryptidfilms.com
# and add that frontend's origin to DJANGO_CORS_ALLOWED_ORIGINS in the backend.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Only used by `npm run dev`.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# --- Dev server -----------------------------------------------------------

# Must match a port listed in the backend's DJANGO_CORS_ALLOWED_ORIGINS.
VITE_PORT=5173
