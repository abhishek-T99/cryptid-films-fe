# --- Secrets ---------------------------------------------------------------
# Vite's stock template ignores only `*.local`, which would leave a plain
# `.env` committed. These rules close that gap; `.env.example` stays tracked
# as the template.
.env
.env.*
!.env.example

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# --- Build output ----------------------------------------------------------
dist/
dist-ssr/
build/
*.local

# --- Logs ------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Caches ----------------------------------------------------------------
.vite/
node_modules/.vite/
.oxlintcache
.eslintcache
coverage/

# --- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini
